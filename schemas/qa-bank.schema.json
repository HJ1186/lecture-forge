{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lecture-forge qa-bank",
  "description": "问答库：离线检索用，pin 字段让它同时变成讲义里的便签。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "q", "a"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^q[0-9]{2,}$",
        "description": "唯一编号，例如 q06"
      },
      "pin": {
        "type": "string",
        "description": "挂到哪个二级标题下（该标题的文字前缀，如 \"三、\"）。省略则只在速答框里出现。"
      },
      "q": {
        "type": "string",
        "minLength": 6,
        "description": "问题，用学生的话写"
      },
      "a": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {"type": "string", "minLength": 4},
        "description": "答案要点，按 定义/对照/规则/算式/一句话 五步写"
      },
      "tags": {
        "type": "array",
        "minItems": 3,
        "items": {"type": "string"},
        "description": "检索关键词，把同一意思的多种说法都列上"
      },
      "open": {
        "type": "boolean",
        "description": "便签默认展开（全篇最多 1-2 条）"
      }
    }
  }
}
